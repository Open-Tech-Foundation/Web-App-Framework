{
  "plugins": [
    {
      "module": "@opentf/esdev-plugin-web",
      "options": {
        "mode": "ssg",
        "appDir": "website/app"
      }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "docsNavPlugin",
      "options": {
        "appDir": "website/app"
      }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "blogPostsPlugin",
      "options": {
        "appDir": "website/app",
        "contentDir": "blog"
      }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "lastUpdatedPlugin",
      "options": {
        "appDir": "website/app"
      }
    },
    {
      "module": "@opentf/web-cli/ssg",
      "export": "siteOutputPlugin",
      "options": {
        "root": "website",
        "target": "site",
        "prerenderTarget": "site-ssg"
      }
    }
  ],
  "build": {
    "targets": {
      "site": {
        "entry": "website/index.html",
        "outdir": "website/dist",
        "assets": [
          "website/public"
        ]
      },
      "site-ssg": {
        "entry": "website/ssg.js",
        "out": "website/.ssg/ssg.js",
        "then": "run"
      }
    }
  },
  "dev": {
    "server": {
      "port": 3005
    }
  }
}
