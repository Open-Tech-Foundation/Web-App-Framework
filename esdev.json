{
  "plugins": [
    {
      "module": "@opentf/esdev-plugin-web",
      "export": "createOtfwPlugin",
      "options": { "target": "hydrate" }
    },
    {
      "module": "@opentf/esdev-plugin-web",
      "export": "createOtfwRoutes",
      "options": { "appDir": "website/app" }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "docsNavPlugin",
      "options": { "appDir": "website/app" }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "blogPostsPlugin",
      "options": { "appDir": "website/app", "contentDir": "blog" }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "lastUpdatedPlugin",
      "options": { "appDir": "website/app" }
    }
  ],
  "targets": {
    "site": {
      "entry": "website/index.html",
      "outdir": "website/dist",
      "assets": ["website/public"]
    },
    "site-ssg": {
      "entry": "website/ssg.js",
      "out": "website/.ssg/ssg.js",
      "then": "run"
    }
  }
}
