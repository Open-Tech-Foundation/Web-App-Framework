{
  "plugins": [
    {
      "module": "@opentf/esdev-plugin-web",
      "export": "createOtfwPlugin",
      "options": {
        "target": "csr"
      }
    },
    {
      "module": "@opentf/esdev-plugin-web",
      "export": "createOtfwRoutes",
      "options": {
        "appDir": "app"
      }
    }
  ],
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outdir": "dist"
      }
    }
  }
}
