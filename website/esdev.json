{
  "plugins": [
    {
      "module": "@opentf/esdev-plugin-web",
      "options": {
        "mode": "ssg",
        "appDir": "app"
      }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "docsNavPlugin",
      "options": {
        "appDir": "app"
      }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "blogPostsPlugin",
      "options": {
        "appDir": "app",
        "contentDir": "blog"
      }
    },
    {
      "module": "@opentf/web-docs/build",
      "export": "lastUpdatedPlugin",
      "options": {
        "appDir": "app"
      }
    }
  ],
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outdir": "dist",
        "assets": [
          "public"
        ]
      },
      "site-ssg": {
        "entry": "ssg.js",
        "out": ".ssg/ssg.js",
        "then": "run"
      }
    }
  }
}
