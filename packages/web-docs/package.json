{
  "name": "@opentf/web-docs",
  "version": "0.28.0",
  "description": "Documentation-site generator for OTF Web — themed shell components (sidebar, TOC, callouts, tabs), a build-time nav generator, and a default light/dark theme.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./theme": "./theme/index.css",
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./config.js"
    },
    "./nav": {
      "types": "./types/nav.d.ts",
      "default": "./nav-virtual.js"
    },
    "./posts": {
      "types": "./types/posts.d.ts",
      "default": "./posts-virtual.js"
    },
    "./updated": {
      "types": "./types/updated.d.ts",
      "default": "./updated-virtual.js"
    },
    "./build": "./build/index.js",
    "./search": {
      "types": "./types/search.d.ts",
      "default": "./search.js"
    }
  },
  "files": [
    "index.js",
    "types",
    "search.js",
    "config.js",
    "nav-virtual.js",
    "posts-virtual.js",
    "updated-virtual.js",
    "components",
    "theme",
    "build",
    "!**/*.test.js"
  ],
  "keywords": [
    "opentf",
    "documentation",
    "docs",
    "mdx",
    "static-site-generator",
    "ssg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/Web-App-Framework.git",
    "directory": "packages/web-docs"
  },
  "homepage": "https://github.com/Open-Tech-Foundation/Web-App-Framework#readme",
  "bugs": "https://github.com/Open-Tech-Foundation/Web-App-Framework/issues",
  "license": "MIT",
  "peerDependencies": {
    "@opentf/web": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentf/web-compiler": "workspace:*"
  },
  "devDependencies": {
    "@opentf/web": "workspace:*",
    "@opentf/web-test": "workspace:*"
  },
  "types": "./types/index.d.ts"
}
