{
  "name": "@opentf/web-test",
  "version": "1.25.0",
  "description": "DOM testing utilities for OTF Web",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "peerDependencies": {
    "@opentf/web": "workspace:*"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1"
