{
  "name": "@opentf/web-cli",
  "version": "1.24.0",
  "description": "OTF Web dev toolchain — the Rolldown-driven CSR dev server, production build, and SSG.",
  "type": "module",
  "bin": {
    "otfw": "./src/cli.js"
  },
  "exports": {
    ".": "./src/cli.js"
  },
  "scripts": {
    "test": "bun test tests/",
    "test:e2e": "bun tests/e2e/serve.mjs && bun tests/e2e/build-data.mjs && bun tests/e2e/build-metadata.mjs && bun tests/e2e/worker-assets.mjs && bun tests/e2e/hydrate-browser.mjs && bun tests/e2e/lifecycle-hooks-browser.mjs && bun tests/e2e/runtime-browser.mjs && bun tests/e2e/template-parity.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@opentf/web-compiler": "0.14.0",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "rolldown": "1.0.0-rc.17",
    "tailwindcss": "4.2.2"
  },
  "peerDependencies": {
    "@opentf/web": "*"
  },
  "keywords": [
    "opentf",
    "web",
    "dev-server",
    "ssg",
    "rolldown",
    "toolchain"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/Web-App-Framework.git",
    "directory": "packages/web-cli"
  },
  "homepage": "https://github.com/Open-Tech-Foundation/Web-App-Framework#readme",
  "bugs": "https://github.com/Open-Tech-Foundation/Web-App-Framework/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
