{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    "types": ["@opentf/esrun-types"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@opentf/web": ["./packages/web/index.js"],
      "@opentf/web/signals": ["./packages/web/core/signals.js"],
      "@opentf/web/reactive": ["./packages/web/core/reactive.js"],
      "@opentf/web/runtime": ["./packages/web/runtime/index.js"],
      "@opentf/web/test": ["./packages/web/test-entry.js"],
      "@opentf/web/compiler": ["./packages/web/compiler/index.js"],
      "@opentf/web-form": ["./packages/web-form/index.js"],
      "@opentf/web-test": ["./packages/web-test/index.js"],
      "@opentf/web-test/*": ["./packages/web-test/*"]
    }
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.dev",
    "**/*.compiled.js",
    "target",
    "benchmarks/**/dist"
  ]
}
