{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-app-framework",
  "compatibility_date": "2026-04-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "website/dist",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
